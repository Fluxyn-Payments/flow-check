# Copy to .env and fill in. Never commit .env.

# API (apps/api)
DEMO_PASSWORD=              # shared password of the demo accounts (shown pre-filled on the sign-in page)
DEMO_TOKEN=                 # signs sessions and agent keys
STATE_SECRET_ID=            # AWS Secrets Manager secret with the testnet state (accounts, Mandates)
DATA_BUCKET=                # S3 bucket: agent training, agent keys, Mandate versions, team
PUBLIC_URL=https://flowcheck.fluxyn.com
AGENT_MODEL=us.anthropic.claude-sonnet-5-5   # Claude on Amazon Bedrock
ANTHROPIC_API_KEY=          # optional fallback when Bedrock is not available
ANTHROPIC_MODEL=

# Ripple Payments Direct (empty = Ripple's public mock server, labeled as simulated)
RIPPLE_CLIENT_ID=
RIPPLE_CLIENT_SECRET=
RIPPLE_TENANT_ID=
RIPPLE_BASE_URL=https://api.test.ripple.com

# MCP server (packages/mcp)
FLOWCHECK_ISSUERS=          # comma-separated issuer accounts trusted by the network
FLOWCHECK_API=https://flowcheck.fluxyn.com
FLOWCHECK_NETWORK=testnet
FLOWCHECK_AGENT_SEED=       # optional: lets the MCP server pay as that agent
FLOWCHECK_RLUSD_ISSUER=

# Mastercard AP4M (packages/rail-ap4m) · XRPL EVM testnet
AGENT_PRIVATE_KEY=          # the agent's EIP-712 voucher signer
MERCHANT_SUBMITTER_KEY=
TEAM_NAME=Fluxyn
