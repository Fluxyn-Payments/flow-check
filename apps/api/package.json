{
  "name": "@fluxyn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx src/local.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@fluxyn/flow-check": "workspace:*",
    "ethers": "6.17.0",
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
