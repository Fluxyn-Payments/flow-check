{
  "name": "@fluxyn/flow-check",
  "version": "0.1.0",
  "description": "Flow Check SDK: verify an AI agent, its business and its Mandate on the XRP Ledger before it pays",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "ripple-keypairs": "3.1.0",
    "xrpl": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
